{
  "expo": {
    "name": "КМ",
    "slug": "km",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "km",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "runtimeVersion": "1",
    "updates": {
      "url": "https://u.expo.dev/3d2acf55-80b4-49ca-b886-3f5d042a36f7",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": { "expo-channel-name": "preview" }
    },
    "backgroundColor": "#2E1F17",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.kafiberlass.km",
      "infoPlist": {
        "UIBackgroundModes": ["location", "fetch"],
        "NSLocationWhenInUseUsageDescription": "Нужно, чтобы открывать карту во время прогулки.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Чтобы карта открывалась, даже когда приложение свёрнуто.",
        "NSMotionUsageDescription": "Чтобы отличать прогулку от поездки и экономить батарею."
      }
    },
    "android": {
      "package": "com.kafiberlass.km",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#2E1F17"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "ACTIVITY_RECOGNITION",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-font",
      "@maplibre/maplibre-react-native",
      "./plugins/withSceneLifecycle",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationAlwaysAndWhenInUsePermission": "Чтобы карта открывалась, даже когда приложение свёрнуто."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Чтобы поставить свою фотографию на аватар."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2E1F17",
          "resizeMode": "contain",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": { "typedRoutes": true },
    "extra": {
      "eas": { "projectId": "3d2acf55-80b4-49ca-b886-3f5d042a36f7" }
    }
  }
}
