# Адрес проекта Supabase и публичный ключ.
#
# Скопируйте этот файл в .env и подставьте свои значения:
#   Supabase → проект → Project Settings → API
#
# Ключ anon публичный по замыслу: он вшивается в приложение, а доступ
# ограничивают политики базы (docs/supabase.sql). Секретный service_role
# в мобильное приложение не попадает никогда.
#
# Без этих переменных приложение работает на демо-друзьях.

EXPO_PUBLIC_SUPABASE_URL=https://ваш-проект.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=ваш-anon-ключ
